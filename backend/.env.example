DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aitrailreporter
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme

# Optional — defaults shown. See app/core/config.py for what these control.
GEOGRAPHIC_CONTEXT_RADIUS_METERS=500
NEARBY_SEARCH_MAX_RADIUS_METERS=50000
AUDIO_STORAGE_DIR=var/audio_uploads
MAX_AUDIO_UPLOAD_SIZE_BYTES=20971520

# Required only for Step 8 transcription (POST .../transcribe). Get your key from
# https://dashboard.sarvam.ai — never commit a real key, never put it in mobile/.
SARVAM_API_KEY=
# Optional — defaults shown.
SARVAM_TRANSCRIPTION_MODEL=saaras:v3
SARVAM_REQUEST_TIMEOUT_SECONDS=60
# Sarvam's SYNCHRONOUS endpoint refuses audio over 30 seconds, so longer
# recordings go through its batch job API instead (create -> upload -> start ->
# poll). These bound that poll. Measured at ~5s end to end for a 55s recording.
SARVAM_BATCH_POLL_INTERVAL_SECONDS=3
SARVAM_BATCH_TIMEOUT_SECONDS=600
# How long a transcription may sit in 'processing' before another attempt may
# reclaim it. Only reachable when the worker running it died mid-flight.
TRANSCRIPTION_STALE_PROCESSING_SECONDS=900

# Required only for Step 9 LLM structured extraction (POST .../extract). Get your
# key from https://console.anthropic.com — never commit a real key, never put it
# in mobile/.
ANTHROPIC_API_KEY=
# Optional — defaults shown.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=2048

# Required only for place-specific Explore questions. Get your key from
# https://www.perplexity.ai/settings/api — never commit a real key, never put it
# in mobile/. This is the WEB RESEARCH layer: it finds what the web says about a
# place the system already knows exists. Without it, place research reports a
# clean failure and the app keeps serving whatever questions it already has.
PERPLEXITY_API_KEY=
# Optional — defaults shown. 'sonar-pro' is roughly twice the price per request
# and returned the same specific facts in side-by-side runs.
PERPLEXITY_MODEL=sonar
PERPLEXITY_REQUEST_TIMEOUT_SECONDS=90
# Paid web searches per place per refresh cycle. The second only runs when the
# first found something, so uninteresting places cost one request.
PERPLEXITY_MAX_QUERIES_PER_PLACE=2

# Required for place discovery (POI discovery, place-autocomplete, locality
# naming). Get your key from https://console.cloud.google.com/google/maps-apis
# with Places API (New) and Geocoding API enabled — never commit a real key,
# never put it in mobile/. Without it, discovery/search report a clean failure
# and coordinates/contributions are still saved with location unresolved.
GOOGLE_MAPS_API_KEY=

# REQUIRED IN PRODUCTION. Durable object storage for uploaded audio and photos.
# Without both of these, the backend falls back to the local filesystem, which
# is EPHEMERAL on Render: uploads appear to work and even transcribe (the file
# is read back from the same container moments later), then vanish on the next
# deploy or restart, breaking admin playback and every transcription retry.
# Because that failure is invisible until it is too late, the backend now
# REFUSES to start storage with APP_ENVIRONMENT=production and these unset,
# rather than silently downgrading. Get them from your Supabase project's
# Settings -> API. The service role key bypasses row-level security — never
# commit it, never put it in mobile/ or admin/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — defaults shown. Separate buckets so audio and photos can be given
# different retention/quota treatment without a code change.
SUPABASE_AUDIO_BUCKET=audio-uploads
SUPABASE_PHOTO_BUCKET=photo-uploads

# Required to use the admin dashboard (Step 18, see admin/README.md). Any long
# random string — never "admin", never committed. Without this set, every
# /api/v1/admin/* route reports a clean 503 rather than being reachable
# unauthenticated.
ADMIN_API_TOKEN=

# Optional — comma-separated browser origins allowed to call /api/v1/admin/*.
# Defaults to the admin app's local dev server if unset.
ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
