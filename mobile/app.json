{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nishka3012.aitrailreporter",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to record where a note or GPS sample was captured, only when you tap \"Capture location\"."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "This app uses your microphone to record a voice note, only when you tap \"Record voice note\".",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app opens your photo library only when you tap \"Choose photo\" on an Explore prompt, so you can share a picture of a place.",
          "cameraPermission": "This app uses your camera only when you tap \"Take photo\" on an Explore prompt, so you can share how a place looks right now."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "237f1720-fc55-4824-ae82-f69477a518d2"
      }
    }
  }
}
